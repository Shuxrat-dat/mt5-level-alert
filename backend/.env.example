# ==== Server ====
PORT=8080
# Path to the SQLite database file (created automatically on first run)
DB_PATH=./data/coordination.db

# ==== Telegram ====
# Get from @BotFather (see docs/INSTALL.md)
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME

# ==== Cluster timing (all values in seconds) ====
# How often each EA is expected to call POST /api/heartbeat.
HEARTBEAT_INTERVAL_SEC=5

# If the currently ACTIVE PC has not sent a heartbeat for this long,
# it is considered dead and a BACKUP is allowed to take over.
# Recommended: 3x HEARTBEAT_INTERVAL_SEC.
FAILOVER_TIMEOUT_SEC=15

# How long a granted ACTIVE lease is valid before it must be renewed.
# Must be >= FAILOVER_TIMEOUT_SEC.
LEASE_DURATION_SEC=20

# A higher-priority PC must be continuously alive for this long before
# it is allowed to preempt a healthy lower-priority ACTIVE PC.
# Prevents role "flapping" on unstable connections.
PROMOTION_STABLE_SEC=10

# ==== Notifications ====
# Secondary safety-net cooldown between two sends for the same level+event.
NOTIFICATION_MIN_INTERVAL_SEC=3

LOG_LEVEL=INFO
